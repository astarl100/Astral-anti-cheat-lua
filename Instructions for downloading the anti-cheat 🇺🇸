local HttpService = game:GetService("HttpService")

local Telegram = {
    Enabled  = true,
    BotToken = "YOUR_BOT_TOKEN",
    ChatID   = "YOUR_CHAT_ID",
}

local Discord = {
    Enabled    = true,
    WebhookURL = "YOUR_WEBHOOK_URL",
}

local function buildMessage(player, reason)
    local now = os.date("!%Y-%m-%d %H:%M:%S")
    return string.format(
        "[Astral] Player: %s (ID: %d)\nReason: %s\nTime (UTC): %s",
        player.Name, player.UserId, reason, now
    )
end

local function sendTelegram(text)
    if not Telegram.Enabled then return end
    local url = ("https://api.telegram.org/bot%s/sendMessage"):format(Telegram.BotToken)
    local body = HttpService:JSONEncode({
        chat_id = Telegram.ChatID,
        text = text,
        parse_mode = "HTML",
    })
    pcall(function()
        HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson)
    end)
end

local function sendDiscord(text)
    if not Discord.Enabled then return end
    local body = HttpService:JSONEncode({
        content = text,
        username = "Astral Anti-Cheat",
    })
    pcall(function()
        HttpService:PostAsync(Discord.WebhookURL, body, Enum.HttpContentType.ApplicationJson)
    end)
end

return {
    Init = function(Astral)
        local originalPunish = Astral.Punish
        Astral.Punish = function(self, player, reason)
            local text = buildMessage(player, reason)
            task.spawn(sendTelegram, text)
            task.spawn(sendDiscord, text)
            return originalPunish(self, player, reason)
        end
    end
}


